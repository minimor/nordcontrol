<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NordControl.App.ViewModels.Customization"
             x:Class="NordControl.App.Views.Customization.CustomizationView"
             x:DataType="vm:CustomizationViewModel">
    <StackPanel Spacing="18">
        <Border Background="#18202A"
                BorderBrush="#3B5268"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <Grid ColumnDefinitions="*,220"
                  ColumnSpacing="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Customization Studio"
                               Foreground="#F4F7FA"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Make Windows feel more personal, modern and enjoyable."
                               Foreground="#AFC2D3"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PersonalizationStatusMessage}"
                               Foreground="#8CF5D2"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#111821"
                        BorderBrush="#435A73"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="NordControl Accent"
                                   Foreground="#8FA1B3"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <Border Background="{Binding NordControlAccentColorHex}"
                                Height="42"
                                CornerRadius="8"/>
                        <TextBlock Text="{Binding NordControlAccentColorHex}"
                                   Foreground="#F4F7FA"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Background="#111821"
                BorderBrush="#2B3B4B"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <ItemsControl ItemsSource="{Binding CustomizationSections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomizationSectionViewModel">
                        <Button Command="{Binding SelectCommand}"
                                Margin="0,0,8,8"
                                Padding="12,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#F4F7FA"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Badge}"
                                           Foreground="#8CF5D2"
                                           FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Background="#151D27"
                BorderBrush="#304459"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding CurrentCustomizationSectionName}"
                               Foreground="#F4F7FA"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentCustomizationSectionDescription}"
                               Foreground="#AFC2D3"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#223040"
                        BorderBrush="#435A73"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,7"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding CurrentCustomizationSectionBadge}"
                               Foreground="#B7D7F2"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="*,*,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="14"
              RowSpacing="14"
              IsVisible="{Binding IsCustomizationOverviewSection}">
            <Border Background="#161D24"
                    BorderBrush="#2C3C4E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="5">
                    <TextBlock Text="Apps Theme"
                               Foreground="#8FA1B3"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AppsTheme}"
                               Foreground="#F4F7FA"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Background="#161D24"
                    BorderBrush="#2C3C4E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="5">
                    <TextBlock Text="System Theme"
                               Foreground="#8FA1B3"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SystemTheme}"
                               Foreground="#F4F7FA"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Background="#161D24"
                    BorderBrush="#2C3C4E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="5">
                    <TextBlock Text="Transparency"
                               Foreground="#8FA1B3"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TransparencyEffectsEnabled}"
                               Foreground="#F4F7FA"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1"
                    Background="#161D24"
                    BorderBrush="#2C3C4E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="5">
                    <TextBlock Text="Accent Color"
                               Foreground="#8FA1B3"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Background="{Binding WindowsAccentColorHex}"
                                Width="32"
                                Height="32"
                                CornerRadius="8"/>
                        <TextBlock Text="{Binding WindowsAccentColorHex}"
                                   Foreground="#F4F7FA"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Background="#161D24"
                    BorderBrush="#2C3C4E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="5">
                    <TextBlock Text="Accent on Title Bars"
                               Foreground="#8FA1B3"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AccentColorOnTitleBars}"
                               Foreground="#F4F7FA"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1"
                    Grid.Column="2"
                    Background="#161D24"
                    BorderBrush="#2C3C4E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="5">
                    <TextBlock Text="Last Loaded"
                               Foreground="#8FA1B3"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PersonalizationLastLoadedText}"
                               Foreground="#F4F7FA"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Background="#161D24"
                BorderBrush="#2C3C4E"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                IsVisible="{Binding IsCustomizationOverviewSection}">
            <StackPanel Spacing="12">
                <TextBlock Text="Wallpaper"
                           Foreground="#8FA1B3"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding WallpaperPath}"
                           Foreground="#D8E1EA"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
              ColumnSpacing="10"
              IsVisible="{Binding IsCustomizationThemesSection}">
            <Button Content="Refresh current style"
                    Command="{Binding RefreshPersonalizationCommand}"/>
            <Button Grid.Column="1"
                    Content="Toggle apps theme"
                    Command="{Binding ToggleAppsThemeCommand}"/>
            <Button Grid.Column="2"
                    Content="Toggle system theme"
                    Command="{Binding ToggleSystemThemeCommand}"/>
            <Button Grid.Column="3"
                    Content="Toggle transparency"
                    Command="{Binding ToggleTransparencyEffectsCommand}"/>
            <Button Grid.Column="4"
                    Content="Toggle title-bar accent"
                    Command="{Binding ToggleAccentColorOnTitleBarsCommand}"/>
        </Grid>

        <StackPanel Spacing="12"
                    IsVisible="{Binding IsCustomizationThemesSection}">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="Theme Packages"
                               Foreground="#F4F7FA"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Reusable app and overlay visual identities for NordControl modules."
                               Foreground="#AFC2D3"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#223040"
                        BorderBrush="#435A73"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,7"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding SelectedThemePackageName}"
                               Foreground="#B7D7F2"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <TextBlock Text="Built-in packages"
                       Foreground="#F4F7FA"
                       FontSize="16"
                       FontWeight="SemiBold"/>

            <ItemsControl ItemsSource="{Binding BuiltInThemePackages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThemePackageViewModel">
                        <Border Width="304"
                                MinHeight="302"
                                Margin="0,0,14,14"
                                Background="{Binding SurfaceColorHex}"
                                BorderBrush="{Binding BorderColorHex}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="0">
                            <Grid RowDefinitions="10,*">
                                <Grid ColumnDefinitions="*,*,*,*,*">
                                    <Border Background="{Binding BackgroundColorHex}"/>
                                    <Border Grid.Column="1"
                                            Background="{Binding SurfaceColorHex}"/>
                                    <Border Grid.Column="2"
                                            Background="{Binding AccentColorHex}"/>
                                    <Border Grid.Column="3"
                                            Background="{Binding SecondaryAccentColorHex}"/>
                                    <Border Grid.Column="4"
                                            Background="{Binding BorderColorHex}"/>
                                </Grid>

                                <StackPanel Grid.Row="1"
                                            Spacing="12"
                                            Margin="16">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{Binding TextColorHex}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Mood}"
                                                       Foreground="{Binding SecondaryAccentColorHex}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{Binding AccentColorHex}"
                                                Width="36"
                                                Height="36"
                                                CornerRadius="8"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{Binding MutedTextColorHex}"
                                               TextWrapping="Wrap"
                                               MinHeight="62"/>

                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding TagsText}"
                                                       Foreground="{Binding TextColorHex}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CornerRadiusText}"
                                                       Foreground="{Binding MutedTextColorHex}"
                                                       FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Spacing="6"
                                                    HorizontalAlignment="Right">
                                            <Border Background="#223040"
                                                    BorderBrush="{Binding AccentColorHex}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="9,5">
                                                <TextBlock Text="{Binding GlassBadge}"
                                                           Foreground="#F4F7FA"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#18202A"
                                                    BorderBrush="{Binding BorderColorHex}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="9,5">
                                                <TextBlock Text="{Binding Source}"
                                                           Foreground="#B7D7F2"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="{Binding SecondaryAccentColorHex}"
                                                    CornerRadius="8"
                                                    Padding="9,5"
                                                    IsVisible="{Binding IsSelected}">
                                                <TextBlock Text="Selected"
                                                           Foreground="#101418"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,*"
                                          ColumnSpacing="8">
                                        <Button Content="Preview"
                                                Command="{Binding PreviewCommand}"/>
                                        <Button Grid.Column="1"
                                                Content="Apply"
                                                Command="{Binding ApplyCommand}"/>
                                        <Button Grid.Column="2"
                                                Content="Export JSON"
                                                Command="{Binding ExportCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="User / imported packages"
                       Foreground="#F4F7FA"
                       FontSize="16"
                       FontWeight="SemiBold"/>

            <Border Background="#111821"
                    BorderBrush="#2B3B4B"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    IsVisible="{Binding ShowNoUserThemePackages}">
                <TextBlock Text="No user themes yet. Import a JSON package or save a custom theme."
                           Foreground="#AFC2D3"
                           TextWrapping="Wrap"/>
            </Border>

            <ItemsControl ItemsSource="{Binding UserThemePackages}"
                          IsVisible="{Binding HasUserThemePackages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThemePackageViewModel">
                        <Border Width="304"
                                MinHeight="244"
                                Margin="0,0,14,14"
                                Background="{Binding SurfaceColorHex}"
                                BorderBrush="{Binding BorderColorHex}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="0">
                            <Grid RowDefinitions="10,*">
                                <Grid ColumnDefinitions="*,*,*,*,*">
                                    <Border Background="{Binding BackgroundColorHex}"/>
                                    <Border Grid.Column="1"
                                            Background="{Binding SurfaceColorHex}"/>
                                    <Border Grid.Column="2"
                                            Background="{Binding AccentColorHex}"/>
                                    <Border Grid.Column="3"
                                            Background="{Binding SecondaryAccentColorHex}"/>
                                    <Border Grid.Column="4"
                                            Background="{Binding BorderColorHex}"/>
                                </Grid>

                                <StackPanel Grid.Row="1"
                                            Spacing="12"
                                            Margin="16">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{Binding TextColorHex}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Mood}"
                                                       Foreground="{Binding SecondaryAccentColorHex}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{Binding AccentColorHex}"
                                                Width="36"
                                                Height="36"
                                                CornerRadius="8"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{Binding MutedTextColorHex}"
                                               TextWrapping="Wrap"
                                               MinHeight="48"/>

                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <TextBlock Text="{Binding TagsText}"
                                                   Foreground="{Binding TextColorHex}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                            <Border Background="#18202A"
                                                    BorderBrush="{Binding BorderColorHex}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="9,5">
                                                <TextBlock Text="{Binding Source}"
                                                           Foreground="#B7D7F2"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="{Binding SecondaryAccentColorHex}"
                                                    CornerRadius="8"
                                                    Padding="9,5"
                                                    IsVisible="{Binding IsSelected}">
                                                <TextBlock Text="Selected"
                                                           Foreground="#101418"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,*"
                                          ColumnSpacing="8">
                                        <Button Content="Preview"
                                                Command="{Binding PreviewCommand}"/>
                                        <Button Grid.Column="1"
                                                Content="Apply"
                                                Command="{Binding ApplyCommand}"/>
                                        <Button Grid.Column="2"
                                                Content="Export JSON"
                                                Command="{Binding ExportCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="16"
              IsVisible="{Binding IsCustomizationThemesSection}">
            <Border Background="#161D24"
                    BorderBrush="#2C3C4E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Import / Export"
                               Foreground="#F4F7FA"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Theme JSON files are stored in the user theme folder and reloaded on startup."
                               Foreground="#AFC2D3"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ThemesDirectoryPath}"
                               Foreground="#B7D7F2"
                               TextWrapping="Wrap"/>
                    <TextBox PlaceholderText="Paste a theme JSON path"
                             Text="{Binding ImportThemeFilePath, Mode=TwoWay}"
                             MinHeight="34"/>
                    <Grid ColumnDefinitions="Auto,Auto,*"
                          ColumnSpacing="10">
                        <Button Content="Import Theme JSON"
                                Command="{Binding ImportThemePackageCommand}"/>
                        <Button Grid.Column="1"
                                Content="Export Selected"
                                Command="{Binding ExportSelectedThemePackageCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding ThemeOperationStatus}"
                               Foreground="#8CF5D2"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{Binding PreviewBackgroundColorHex}"
                    BorderBrush="{Binding PreviewBorderColorHex}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Live Preview"
                                       Foreground="{Binding PreviewTextColorHex}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PreviewThemeName}"
                                       Foreground="{Binding PreviewMutedTextColorHex}"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{Binding PreviewAccentColorHex}"
                                Width="42"
                                Height="42"
                                CornerRadius="8"/>
                    </Grid>

                    <Border Background="{Binding PreviewSurfaceColorHex}"
                            BorderBrush="{Binding PreviewBorderColorHex}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Grid ColumnDefinitions="76,*"
                              ColumnSpacing="12">
                            <StackPanel Spacing="8">
                                <Border Height="10"
                                        Background="{Binding PreviewAccentColorHex}"
                                        CornerRadius="5"/>
                                <Border Height="10"
                                        Background="{Binding PreviewMutedTextColorHex}"
                                        CornerRadius="5"/>
                                <Border Height="10"
                                        Background="{Binding PreviewMutedTextColorHex}"
                                        CornerRadius="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Spacing="8">
                                <TextBlock Text="NordControl shell"
                                           Foreground="{Binding PreviewTextColorHex}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Cards, widgets, launcher, and taskbar previews can share this package later."
                                           Foreground="{Binding PreviewMutedTextColorHex}"
                                           TextWrapping="Wrap"/>
                                <Border Background="{Binding PreviewAccentColorHex}"
                                        CornerRadius="8"
                                        Padding="12,7"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="Accent action"
                                               Foreground="#101418"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding PreviewGlassText}"
                               Foreground="{Binding PreviewSecondaryAccentColorHex}"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Background="#161D24"
                BorderBrush="#2C3C4E"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18"
                IsVisible="{Binding IsCustomizationThemesSection}">
            <StackPanel Spacing="14">
                <TextBlock Text="Custom Theme Editor"
                           Foreground="#F4F7FA"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="14"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Theme name"
                                   Foreground="#D8E1EA"/>
                        <TextBox Text="{Binding CustomThemeName, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Spacing="6">
                        <TextBlock Text="Mood / style"
                                   Foreground="#D8E1EA"/>
                        <TextBox Text="{Binding CustomMood, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Spacing="6">
                        <TextBlock Text="Description"
                                   Foreground="#D8E1EA"/>
                        <TextBox Text="{Binding CustomThemeDescription, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                Spacing="6">
                        <TextBlock Text="Accent color"
                                   Foreground="#D8E1EA"/>
                        <Grid ColumnDefinitions="*,40"
                              ColumnSpacing="8">
                            <TextBox Text="{Binding CustomAccentColorHex, Mode=TwoWay}"/>
                            <Border Grid.Column="1"
                                    Background="{Binding CustomAccentColorHex}"
                                    BorderBrush="#304459"
                                    BorderThickness="1"
                                    CornerRadius="8"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Spacing="6">
                        <TextBlock Text="Background color"
                                   Foreground="#D8E1EA"/>
                        <Grid ColumnDefinitions="*,40"
                              ColumnSpacing="8">
                            <TextBox Text="{Binding CustomBackgroundColorHex, Mode=TwoWay}"/>
                            <Border Grid.Column="1"
                                    Background="{Binding CustomBackgroundColorHex}"
                                    BorderBrush="#304459"
                                    BorderThickness="1"
                                    CornerRadius="8"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3"
                                Spacing="6">
                        <TextBlock Text="Surface color"
                                   Foreground="#D8E1EA"/>
                        <Grid ColumnDefinitions="*,40"
                              ColumnSpacing="8">
                            <TextBox Text="{Binding CustomSurfaceColorHex, Mode=TwoWay}"/>
                            <Border Grid.Column="1"
                                    Background="{Binding CustomSurfaceColorHex}"
                                    BorderBrush="#304459"
                                    BorderThickness="1"
                                    CornerRadius="8"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3"
                                Grid.Column="1"
                                Spacing="6">
                        <TextBlock Text="Text color"
                                   Foreground="#D8E1EA"/>
                        <Grid ColumnDefinitions="*,40"
                              ColumnSpacing="8">
                            <TextBox Text="{Binding CustomTextColorHex, Mode=TwoWay}"/>
                            <Border Grid.Column="1"
                                    Background="{Binding CustomTextColorHex}"
                                    BorderBrush="#304459"
                                    BorderThickness="1"
                                    CornerRadius="8"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                <CheckBox Content="Enable glass style"
                          IsChecked="{Binding CustomEnableGlass, Mode=TwoWay}"/>
                <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                      ColumnSpacing="10">
                    <Button Content="Preview Custom Theme"
                            Command="{Binding PreviewCustomThemeCommand}"/>
                    <Button Grid.Column="1"
                            Content="Save Custom Theme"
                            Command="{Binding SaveCustomThemeCommand}"/>
                    <Button Grid.Column="2"
                            Content="Reset Editor"
                            Command="{Binding ResetCustomThemeEditorCommand}"/>
                </Grid>
                <TextBlock Text="{Binding CustomThemeValidationMessage}"
                           Foreground="#FFD166"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Spacing="12"
                    IsVisible="{Binding IsCustomizationThemesSection}">
            <TextBlock Text="Preset Gallery"
                       Foreground="#F4F7FA"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding CustomizationPresets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomizationPresetViewModel">
                        <Border Width="250"
                                MinHeight="210"
                                Margin="0,0,14,14"
                                Background="#151D27"
                                BorderBrush="#304459"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,42">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#F4F7FA"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <Border Grid.Column="1"
                                            Background="{Binding AccentColorHex}"
                                            Width="34"
                                            Height="34"
                                            CornerRadius="8"/>
                                </Grid>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="#AFC2D3"
                                           TextWrapping="Wrap"
                                           MinHeight="52"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding StyleMood}"
                                               Foreground="#8CF5D2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RiskLevel}"
                                               Foreground="#FFD166"/>
                                </Grid>
                                <TextBlock Text="{Binding BackgroundHint}"
                                           Foreground="#8FA1B3"/>
                                <Button Content="Preview / Apply to NordControl"
                                        Command="{Binding ApplyCommand}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="14"
                    IsVisible="{Binding IsCustomizationTaskbarSection}">
            <Border Background="#111821"
                    BorderBrush="#33506A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="14">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Taskbar Lab"
                                   Foreground="#F4F7FA"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Experimental Windows taskbar styling and layout control"
                                   Foreground="#AFC2D3"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TaskbarStatusMessage}"
                                   Foreground="#8CF5D2"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Border Background="#223040"
                                BorderBrush="#435A73"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,7">
                            <TextBlock Text="{Binding TaskbarLabRiskBadge}"
                                       Foreground="#B7D7F2"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#16251F"
                                BorderBrush="#2D705D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,7">
                            <TextBlock Text="{Binding TaskbarPreviewOnlyStatus}"
                                       Foreground="#BEEBDD"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*,*"
                  ColumnSpacing="12">
                <Border Background="#161D24"
                        BorderBrush="#2C3C4E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Windows"
                                   Foreground="#8FA1B3"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TaskbarIsWindowsText}"
                                   Foreground="#F4F7FA"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        Background="#161D24"
                        BorderBrush="#2C3C4E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Alignment"
                                   Foreground="#8FA1B3"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TaskbarAlignment}"
                                   Foreground="#F4F7FA"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2"
                        Background="#161D24"
                        BorderBrush="#2C3C4E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Auto-hide"
                                   Foreground="#8FA1B3"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TaskbarAutoHideStatus}"
                                   Foreground="#F4F7FA"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3"
                        Background="#161D24"
                        BorderBrush="#2C3C4E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Transparency"
                                   Foreground="#8FA1B3"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TaskbarTransparencyMode}"
                                   Foreground="#F4F7FA"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4"
                        Background="#161D24"
                        BorderBrush="#2C3C4E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Last loaded"
                                   Foreground="#8FA1B3"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TaskbarLastLoadedText}"
                                   Foreground="#F4F7FA"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="1.1*,1.4*"
                  ColumnSpacing="14">
                <Border Background="#161D24"
                        BorderBrush="#2C3C4E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Safety Controls"
                                           Foreground="#F4F7FA"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TaskbarNotes}"
                                           Foreground="#AFC2D3"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Command="{Binding RefreshTaskbarStateCommand}"/>
                        </Grid>
                        <CheckBox Content="Enable Taskbar Lab"
                                  IsChecked="{Binding EnableTaskbarLab, Mode=TwoWay}"/>
                        <CheckBox Content="Preview-only mode"
                                  IsChecked="{Binding UseTaskbarPreviewOnlyMode, Mode=TwoWay}"/>
                        <CheckBox Content="Allow medium-risk taskbar changes"
                                  IsChecked="{Binding AllowMediumRiskTaskbarChanges, Mode=TwoWay}"/>
                        <CheckBox Content="Show taskbar warnings"
                                  IsChecked="{Binding ShowTaskbarWarnings, Mode=TwoWay}"/>
                        <Border Background="#1F1A2C"
                                BorderBrush="#57427A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                IsVisible="{Binding ShowTaskbarWarnings}">
                            <TextBlock Text="Taskbar Lab V1 does not patch Explorer, hook the shell, replace the real taskbar, restart Explorer, install services, or silently write risky registry values."
                                       Foreground="#D9C8FF"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{Binding TaskbarPreviewDesktopColorHex}"
                        BorderBrush="#2C3C4E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <Grid RowDefinitions="Auto,*,Auto"
                          MinHeight="278">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Live Taskbar Preview"
                                           Foreground="{Binding TaskbarPreviewIconColorHex}"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedTaskbarPresetName}"
                                           Foreground="{Binding TaskbarPreviewAccentColorHex}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{Binding TaskbarPreviewAccentColorHex}"
                                    Width="42"
                                    Height="42"
                                    CornerRadius="8"/>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,18"
                              RowDefinitions="*,Auto">
                            <StackPanel Spacing="10"
                                        VerticalAlignment="Center">
                                <Border Background="{Binding TaskbarPreviewRailColorHex}"
                                        Height="12"
                                        Width="190"
                                        CornerRadius="6"
                                        HorizontalAlignment="Left"
                                        Opacity="0.75"/>
                                <Border Background="{Binding TaskbarPreviewRailColorHex}"
                                        Height="12"
                                        Width="260"
                                        CornerRadius="6"
                                        HorizontalAlignment="Left"
                                        Opacity="0.52"/>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Background="{Binding TaskbarPreviewSurfaceColorHex}"
                                    BorderBrush="{Binding TaskbarPreviewAccentColorHex}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="10,0">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="16">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <Border Background="{Binding TaskbarPreviewAccentColorHex}"
                                                Width="20"
                                                Height="20"
                                                CornerRadius="5"/>
                                        <Border Background="{Binding TaskbarPreviewIconColorHex}"
                                                Width="20"
                                                Height="20"
                                                CornerRadius="5"
                                                Opacity="0.85"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                HorizontalAlignment="Center">
                                        <Border Background="{Binding TaskbarPreviewIconColorHex}"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="7"
                                                Opacity="0.85"/>
                                        <Border Background="{Binding TaskbarPreviewAccentColorHex}"
                                                Width="36"
                                                Height="28"
                                                CornerRadius="7"/>
                                        <Border Background="{Binding TaskbarPreviewIconColorHex}"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="7"
                                                Opacity="0.65"/>
                                        <Border Background="{Binding TaskbarPreviewIconColorHex}"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="7"
                                                Opacity="0.65"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="7">
                                        <Border Background="{Binding TaskbarPreviewRailColorHex}"
                                                Width="34"
                                                Height="20"
                                                CornerRadius="6"/>
                                        <Border Background="{Binding TaskbarPreviewAccentColorHex}"
                                                Width="20"
                                                Height="20"
                                                CornerRadius="6"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2"
                                    Spacing="4">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <TextBlock Text="{Binding TaskbarPreviewVisualStyle}"
                                           Foreground="{Binding TaskbarPreviewIconColorHex}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TaskbarPreviewRiskLevel}"
                                           Foreground="#FFD166"/>
                            </Grid>
                            <TextBlock Text="{Binding TaskbarPreviewDescription}"
                                       Foreground="#AFC2D3"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Taskbar Preset Gallery"
                                   Foreground="#F4F7FA"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Preview-only style packages for future safe taskbar work."
                                   Foreground="#AFC2D3"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Reset Preview"
                            Command="{Binding ResetTaskbarPreviewCommand}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding TaskbarPresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskbarPresetViewModel">
                            <Border Width="300"
                                    MinHeight="258"
                                    Margin="0,0,14,14"
                                    Background="#151D27"
                                    BorderBrush="#304459"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="0">
                                <Grid RowDefinitions="10,*">
                                    <Border Background="{Binding AccentColorHex}"
                                            CornerRadius="8,8,0,0"/>
                                    <StackPanel Grid.Row="1"
                                                Spacing="10"
                                                Margin="16">
                                        <Grid ColumnDefinitions="*,40"
                                              ColumnSpacing="10">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#F4F7FA"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <Border Grid.Column="1"
                                                    Background="{Binding AccentColorHex}"
                                                    Width="34"
                                                    Height="34"
                                                    CornerRadius="8"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#AFC2D3"
                                                   TextWrapping="Wrap"
                                                   MinHeight="58"/>
                                        <TextBlock Text="{Binding VisualStyle}"
                                                   Foreground="#8CF5D2"
                                                   FontWeight="SemiBold"/>
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{Binding RiskLevel}"
                                                           Foreground="#FFD166"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding RestartBadge}"
                                                           Foreground="#8FA1B3"
                                                           FontSize="12"/>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="#223040"
                                                    BorderBrush="{Binding AccentColorHex}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="9,5"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding ModeBadge}"
                                                           Foreground="#F4F7FA"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*"
                                              ColumnSpacing="8">
                                            <Button Content="Preview"
                                                    Command="{Binding PreviewCommand}"/>
                                            <Button Grid.Column="1"
                                                    Content="Apply"
                                                    Command="{Binding ApplyCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Background="#16251F"
                    BorderBrush="#2D705D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="Risk Lab Boundary"
                               Foreground="#F4F7FA"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Real taskbar blur, replacement, Explorer hooks, and shell-level taskbar modules remain future Risk Lab work with explicit confirmation, logging, and rollback planning."
                               Foreground="#BEEBDD"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Taskbar Lab V1 is app-only preview plus read-only current-user taskbar detection."
                               Foreground="#8FA1B3"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Spacing="14"
                    IsVisible="{Binding IsCustomizationDesktopWidgetsSection}">
            <Border Background="#111821"
                    BorderBrush="#4C3F73"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="14">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Desktop Widgets"
                                   Foreground="#F4F7FA"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Lightweight overlay modules for desktop workflow"
                                   Foreground="#AFC2D3"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DesktopWidgetStatusMessage}"
                                   Foreground="#8CF5D2"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Border Background="#223040"
                                BorderBrush="#435A73"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,7">
                            <TextBlock Text="{Binding DesktopWidgetsStatusBadge}"
                                       Foreground="#B7D7F2"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#1F1A2C"
                                BorderBrush="#57427A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,7">
                            <TextBlock Text="Low / Medium"
                                       Foreground="#D9C8FF"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="1.05*,1.35*"
                  ColumnSpacing="14">
                <Border Background="#161D24"
                        BorderBrush="#2C3C4E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Global Controls"
                                   Foreground="#F4F7FA"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="8">
                            <Border Background="#223040"
                                    BorderBrush="#435A73"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Visible"
                                               Foreground="#8FA1B3"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DesktopWidgetVisibilityText}"
                                               Foreground="#F4F7FA"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1"
                                    Background="#223040"
                                    BorderBrush="#435A73"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Active"
                                               Foreground="#8FA1B3"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ActiveDesktopWidgetCount}"
                                               Foreground="#F4F7FA"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Background="#223040"
                                    BorderBrush="#435A73"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Lock"
                                               Foreground="#8FA1B3"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DesktopWidgetLockStatusText}"
                                               Foreground="#F4F7FA"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <CheckBox Content="Enable Widgets"
                                  IsChecked="{Binding EnableDesktopWidgets, Mode=TwoWay}"/>
                        <CheckBox Content="Start Widgets With App"
                                  IsChecked="{Binding StartWidgetsWithApp, Mode=TwoWay}"/>
                        <CheckBox Content="Lock Widget Positions"
                                  IsChecked="{Binding LockWidgetPositions, Mode=TwoWay}"/>
                        <CheckBox Content="Show Widget Background"
                                  IsChecked="{Binding ShowWidgetBackground, Mode=TwoWay}"/>
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Global Opacity"
                                           Foreground="#D8E1EA"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DesktopWidgetGlobalOpacity}"
                                           Foreground="#8CF5D2"/>
                            </Grid>
                            <Slider Minimum="0.2"
                                    Maximum="1"
                                    TickFrequency="0.05"
                                    Value="{Binding DesktopWidgetGlobalOpacity, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Selected Widget Theme"
                                       Foreground="#D8E1EA"
                                       FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedWidgetThemeKey, Mode=TwoWay}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="8">
                            <Button Content="Show Widgets"
                                    Command="{Binding ShowDesktopWidgetsCommand}"/>
                            <Button Grid.Column="1"
                                    Content="Hide Widgets"
                                    Command="{Binding HideDesktopWidgetsCommand}"/>
                            <Button Grid.Column="2"
                                    Content="Reset Layout"
                                    Command="{Binding ResetDesktopWidgetLayoutCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8">
                            <Button Content="Lock / Unlock Positions"
                                    Command="{Binding ToggleDesktopWidgetPositionLockCommand}"/>
                            <Button Grid.Column="1"
                                    Content="Save Layout"
                                    Command="{Binding SaveDesktopWidgetLayoutCommand}"/>
                        </Grid>
                        <Border Background="#111821"
                                BorderBrush="#304459"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <TextBlock Text="{Binding DesktopWidgetLayoutSummary}"
                                       Foreground="#AFC2D3"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="#101418"
                        BorderBrush="#2C3C4E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <Grid RowDefinitions="Auto,*"
                          MinHeight="330">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Live Preview"
                                           Foreground="#F4F7FA"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="App-only widget overlay mockup"
                                           Foreground="#AFC2D3"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{Binding DesktopWidgetPreviewAccentHex}"
                                    Width="42"
                                    Height="42"
                                    CornerRadius="8"/>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,16,0,0"
                              Background="#0E1218"
                              RowDefinitions="*,Auto"
                              ClipToBounds="True">
                            <StackPanel Margin="18"
                                        Spacing="10">
                                <Border Height="12"
                                        Width="180"
                                        Background="#223040"
                                        CornerRadius="6"
                                        HorizontalAlignment="Left"/>
                                <Border Height="12"
                                        Width="260"
                                        Background="#223040"
                                        CornerRadius="6"
                                        Opacity="0.55"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>

                            <Grid Margin="28,58,28,34"
                                  ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="14"
                                  RowSpacing="14"
                                  Opacity="{Binding DesktopWidgetPreviewOpacity}">
                                <Border Background="{Binding DesktopWidgetPreviewBackgroundHex}"
                                        BorderBrush="#4CC2FF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Clock"
                                                       Foreground="#8FA1B3"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DesktopWidgetLockStatusText}"
                                                       Foreground="#4CC2FF"
                                                       FontSize="10"/>
                                        </Grid>
                                        <TextBlock Text="14:32:08"
                                                   Foreground="#F4F7FA"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Desktop overlay card"
                                                   Foreground="#AFC2D3"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1"
                                        Background="{Binding DesktopWidgetPreviewBackgroundHex}"
                                        BorderBrush="#8CF5D2"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="System Monitor"
                                                   Foreground="#8FA1B3"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="App CPU: live"
                                                   Foreground="#F4F7FA"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="App memory: live"
                                                   Foreground="#AFC2D3"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{Binding DesktopWidgetPreviewBackgroundHex}"
                                        BorderBrush="#A78BFA"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Opacity="0.72">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Music"
                                                   Foreground="#8FA1B3"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Planned"
                                                   Foreground="#D8E1EA"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1"
                                        Grid.Column="1"
                                        Background="{Binding DesktopWidgetPreviewBackgroundHex}"
                                        BorderBrush="#FFD166"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Opacity="0.72">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Notes"
                                                   Foreground="#8FA1B3"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Planned"
                                                   Foreground="#D8E1EA"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Spacing="12">
                <TextBlock Text="Widget Gallery"
                           Foreground="#F4F7FA"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding DesktopWidgetDefinitions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DesktopWidgetDefinitionViewModel">
                            <Border Width="292"
                                    MinHeight="242"
                                    Margin="0,0,14,14"
                                    Background="#151D27"
                                    BorderBrush="#304459"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="0">
                                <Grid RowDefinitions="10,*">
                                    <Border Background="{Binding AccentColorHex}"
                                            CornerRadius="8,8,0,0"/>
                                    <StackPanel Grid.Row="1"
                                                Spacing="10"
                                                Margin="16">
                                        <Grid ColumnDefinitions="*,38"
                                              ColumnSpacing="10">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#F4F7FA"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <Border Grid.Column="1"
                                                    Background="{Binding AccentColorHex}"
                                                    Width="32"
                                                    Height="32"
                                                    CornerRadius="8"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#AFC2D3"
                                                   TextWrapping="Wrap"
                                                   MinHeight="58"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{Binding Category}"
                                                           Foreground="#8CF5D2"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding RiskLevel}"
                                                           Foreground="#FFD166"/>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="#223040"
                                                    BorderBrush="{Binding AccentColorHex}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="9,5"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding ImplementationBadge}"
                                                           Foreground="#F4F7FA"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <CheckBox Content="Enabled"
                                                      IsEnabled="{Binding IsImplemented}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Content="Show"
                                                    IsEnabled="{Binding IsImplemented}"
                                                    Command="{Binding ShowCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Background="#16251F"
                    BorderBrush="#2D705D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="Safety Note"
                               Foreground="#F4F7FA"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Widgets are NordControl-owned Avalonia overlay windows. They do not patch Explorer, inject into the shell, replace the desktop, install services, or use global hooks."
                               Foreground="#BEEBDD"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Use Hide Widgets from NordControl or close the widget windows normally."
                               Foreground="#8FA1B3"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Spacing="12"
                    IsVisible="{Binding IsCustomizationOverviewSection}">
            <TextBlock Text="Desktop Environment Roadmap"
                       Foreground="#F4F7FA"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding CurrentCustomizationFeatureCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomizationFeatureCardViewModel">
                        <Border Width="250"
                                MinHeight="168"
                                Margin="0,0,14,14"
                                Background="#151D27"
                                BorderBrush="#304459"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="*,34">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#F4F7FA"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <Border Grid.Column="1"
                                            Background="{Binding AccentColorHex}"
                                            Width="28"
                                            Height="28"
                                            CornerRadius="8"/>
                                </Grid>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="#AFC2D3"
                                           TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Badge}"
                                               Foreground="#8CF5D2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RiskLevel}"
                                               Foreground="#FFD166"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="12"
                    IsVisible="{Binding IsCustomizationPlanningSection}">
            <Border Background="#1F1A2C"
                    BorderBrush="#57427A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    IsVisible="{Binding IsCustomizationRiskLabSection}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Risk Lab"
                               Foreground="#F4F7FA"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="These experiments are disabled for now. Shell-level customization can break after Windows updates and will require explicit confirmation, logging, and rollback planning."
                               Foreground="#FFD6D6"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding CurrentCustomizationFeatureCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomizationFeatureCardViewModel">
                        <Border Width="270"
                                MinHeight="198"
                                Margin="0,0,14,14"
                                Background="#151D27"
                                BorderBrush="#304459"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,38">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#F4F7FA"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <Border Grid.Column="1"
                                            Background="{Binding AccentColorHex}"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="8"/>
                                </Grid>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="#AFC2D3"
                                           TextWrapping="Wrap"
                                           MinHeight="56"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Badge}"
                                               Foreground="#8CF5D2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RiskLevel}"
                                               Foreground="#FFD166"/>
                                </Grid>
                                <Button Content="Coming later"
                                        IsEnabled="False"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="16"
              IsVisible="{Binding IsCustomizationOverviewSection}">
            <Border Background="#16251F"
                    BorderBrush="#2D705D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="Safety Notes"
                               Foreground="#F4F7FA"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Safe changes only. No Explorer patching, no system DLL modifications, no process injection, and no risky optimizer behavior."
                               Foreground="#BEEBDD"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Riskier features will require explicit confirmation, logs, and rollback planning in future versions."
                               Foreground="#8FA1B3"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#1F1A2C"
                    BorderBrush="#57427A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="Future Features"
                               Foreground="#F4F7FA"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Transparent taskbar, Start menu experiments, desktop widgets, window border styles, per-app visual profiles, and a custom command palette."
                               Foreground="#D9C8FF"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="These are planned, not implemented."
                               Foreground="#8FA1B3"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
