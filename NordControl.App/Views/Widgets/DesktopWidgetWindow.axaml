<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="using:NordControl.App.Views.Widgets"
        xmlns:vm="using:NordControl.App.ViewModels.Widgets"
        x:Class="NordControl.App.Views.Widgets.DesktopWidgetWindow"
        x:DataType="vm:DesktopWidgetWindowViewModel"
        Title="{Binding WidgetName}"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ShowInTaskbar="False"
        CanResize="False">
    <Border Background="{Binding WidgetBackgroundColor}"
            BorderBrush="{Binding AccentColorHex}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="{Binding EffectiveOpacity}">
        <Grid RowDefinitions="Auto,*">
            <Grid Background="#33101820"
                  ColumnDefinitions="*,Auto"
                  MinHeight="34">
                <Border x:Name="DragSurface"
                        Padding="12,8"
                        PointerPressed="OnDragSurfacePointerPressed">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Border Background="{Binding AccentColorHex}"
                                Width="7"
                                Height="18"
                                CornerRadius="4"/>
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding WidgetName}"
                                       Foreground="#F4F7FA"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DragHintText}"
                                       Foreground="#8FA1B3"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="7"
                            Margin="0,6,8,6"
                            VerticalAlignment="Top">
                    <Border Background="#223040"
                            BorderBrush="#435A73"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="7,3">
                        <TextBlock Text="{Binding LockStatusText}"
                                   Foreground="#B7D7F2"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="Hide"
                            Command="{Binding CloseWidgetCommand}"
                            Padding="8,3"
                            FontSize="10"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Padding="16">
                <Grid>
                    <widgets:ClockWidgetView IsVisible="{Binding IsClockWidget}"/>
                    <widgets:SystemMonitorLiteWidgetView IsVisible="{Binding IsSystemMonitorLiteWidget}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
