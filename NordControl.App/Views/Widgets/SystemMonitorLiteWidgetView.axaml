<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NordControl.App.ViewModels.Widgets"
             x:Class="NordControl.App.Views.Widgets.SystemMonitorLiteWidgetView"
             x:DataType="vm:DesktopWidgetWindowViewModel">
    <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Live system snapshot"
                       Foreground="{Binding AccentColorHex}"
                       FontSize="13"
                       FontWeight="SemiBold"/>
            <Border Grid.Column="1"
                    Background="{Binding AccentColorHex}"
                    Width="34"
                    Height="8"
                    CornerRadius="4"
                    VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="{Binding CpuText}"
                   Foreground="#F4F7FA"
                   FontSize="22"
                   FontWeight="SemiBold"/>
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding MemoryText}"
                       Foreground="#D8E1EA"
                       FontSize="17"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding LockStatusText}"
                       Foreground="#8FA1B3"
                       FontSize="11"/>
        </Grid>
        <TextBlock Text="{Binding MemoryDetailText}"
                   Foreground="#AFC2D3"
                   FontSize="12"
                   TextWrapping="Wrap"/>
        <TextBlock Text="{Binding MonitorNote}"
                   Foreground="#8FA1B3"
                   FontSize="12"
                   TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
