<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NordControl.App.ViewModels.Settings"
             x:Class="NordControl.App.Views.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <StackPanel Spacing="18">
        <Border Background="#161D24"
                BorderBrush="#273442"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <StackPanel Spacing="10">
                <TextBlock Text="Settings File"
                           Foreground="#F4F7FA"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SettingsFilePath}"
                           Foreground="#B7D7F2"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SettingsStatusMessage}"
                           Foreground="#9AAABD"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Background="#161D24"
                BorderBrush="#273442"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <StackPanel Spacing="14">
                <TextBlock Text="Theme"
                           Foreground="#F4F7FA"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <RadioButton Content="Dark"
                                 IsChecked="True"/>
                    <RadioButton Content="Light (coming later)"
                                 IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Background="#161D24"
                BorderBrush="#273442"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <StackPanel Spacing="14">
                <TextBlock Text="Window Manager"
                           Foreground="#F4F7FA"
                           FontSize="18"
                           FontWeight="SemiBold"/>

                <CheckBox Content="Refresh window list on startup"
                          IsChecked="{Binding RefreshOnStartup, Mode=TwoWay}"/>

                <Grid ColumnDefinitions="260,160,*"
                      ColumnSpacing="12"
                      VerticalAlignment="Center">
                    <TextBlock Text="Auto refresh interval seconds"
                               Foreground="#D8E1EA"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding AutoRefreshIntervalSeconds, Mode=TwoWay}"
                             MinHeight="34"/>
                    <TextBlock Grid.Column="2"
                               Text="0 disables auto-refresh. A positive value refreshes the window list every N seconds."
                               Foreground="#8FA1B3"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="{Binding AutoRefreshStatus}"
                           Foreground="#B7D7F2"
                           TextWrapping="Wrap"/>

                <CheckBox Content="Confirm before pinning"
                          IsChecked="{Binding ConfirmBeforePinning, Mode=TwoWay}"/>

                <CheckBox Content="Show unknown processes"
                          IsChecked="{Binding ShowUnknownProcesses, Mode=TwoWay}"/>
            </StackPanel>
        </Border>

        <Border Background="#161D24"
                BorderBrush="#273442"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <StackPanel Spacing="14">
                <TextBlock Text="Customization"
                           Foreground="#F4F7FA"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="220,*"
                      ColumnSpacing="12">
                    <TextBlock Text="Selected preset"
                               Foreground="#D8E1EA"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedCustomizationPresetKey}"
                               Foreground="#B7D7F2"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="220,*"
                      ColumnSpacing="12">
                    <TextBlock Text="Theme package"
                               Foreground="#D8E1EA"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedThemePackageKey}"
                               Foreground="#B7D7F2"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="220,*"
                      ColumnSpacing="12">
                    <TextBlock Text="Last exported theme"
                               Foreground="#D8E1EA"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding LastExportedThemePath}"
                               Foreground="#B7D7F2"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="220,*"
                      ColumnSpacing="12">
                    <TextBlock Text="Last imported theme"
                               Foreground="#D8E1EA"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding LastImportedThemePath}"
                               Foreground="#B7D7F2"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="220,*"
                      ColumnSpacing="12">
                    <TextBlock Text="Customization section"
                               Foreground="#D8E1EA"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentCustomizationSectionName}"
                               Foreground="#B7D7F2"
                               VerticalAlignment="Center"/>
                </Grid>
                <CheckBox Content="Apply theme packages to NordControl shell preview"
                          IsChecked="{Binding ApplyThemeToNordControlShell, Mode=TwoWay}"/>
                <Grid ColumnDefinitions="220,*"
                      ColumnSpacing="12">
                    <TextBlock Text="NordControl accent"
                               Foreground="#D8E1EA"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding NordControlAccentColorHex, Mode=TwoWay}"
                             MinHeight="34"/>
                </Grid>
                <CheckBox Content="Enable glass style in NordControl preview"
                          IsChecked="{Binding EnableGlassStyleInApp, Mode=TwoWay}"/>
                <CheckBox Content="Allow low-risk Windows personalization actions"
                          IsChecked="{Binding AllowLowRiskWindowsPersonalization, Mode=TwoWay}"/>
            </StackPanel>
        </Border>

        <Border Background="#161D24"
                BorderBrush="#273442"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <StackPanel Spacing="14">
                <TextBlock Text="Command Launcher"
                           Foreground="#F4F7FA"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <CheckBox Content="Enable Launcher"
                          IsChecked="{Binding EnableLauncher, Mode=TwoWay}"/>
                <CheckBox Content="Start launcher services with app"
                          IsChecked="{Binding LauncherStartWithApp, Mode=TwoWay}"/>
                <Grid ColumnDefinitions="220,*"
                      ColumnSpacing="12">
                    <TextBlock Text="Hotkey"
                               Foreground="#D8E1EA"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding LauncherHotkeyGesture, Mode=TwoWay}"
                             MinHeight="34"/>
                </Grid>
                <TextBlock Text="V1 supports Ctrl+Space while NordControl is focused. Native global hotkey registration is planned after the window message pump is isolated."
                           Foreground="#8FA1B3"
                           TextWrapping="Wrap"/>
                <CheckBox Content="Show launcher on startup"
                          IsChecked="{Binding LauncherShowOnStartup, Mode=TwoWay}"/>
                <CheckBox Content="Include NordControl commands"
                          IsChecked="{Binding LauncherIncludeNordControlCommands, Mode=TwoWay}"/>
                <CheckBox Content="Include Start Menu apps"
                          IsChecked="{Binding LauncherIncludeApps, Mode=TwoWay}"/>
                <CheckBox Content="Include safe system actions"
                          IsChecked="{Binding LauncherIncludeSystemActions, Mode=TwoWay}"/>
                <CheckBox Content="Close after action"
                          IsChecked="{Binding LauncherCloseAfterAction, Mode=TwoWay}"/>
                <Grid ColumnDefinitions="220,160,*"
                      ColumnSpacing="12">
                    <TextBlock Text="Max results"
                               Foreground="#D8E1EA"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding LauncherMaxResults, Mode=TwoWay}"
                             MinHeight="34"/>
                    <TextBlock Grid.Column="2"
                               Text="Clamped between 8 and 20."
                               Foreground="#8FA1B3"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,Auto,Auto,*"
              ColumnSpacing="12">
            <Button Content="Save Settings"
                    Command="{Binding SaveSettingsCommand}"/>
            <Button Grid.Column="1"
                    Content="Reload Settings"
                    Command="{Binding ReloadSettingsCommand}"/>
            <Button Grid.Column="2"
                    Content="Reset to Defaults"
                    Command="{Binding ResetSettingsCommand}"/>
        </Grid>
    </StackPanel>
</UserControl>
