<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:NordControl.App.ViewModels.Shell"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="760"
        x:Class="NordControl.App.Views.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="NordControl"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="600"
        Background="#101418">

    <Design.DataContext>
        <shell:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#D8E1EA"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="#D8E1EA"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="260,*">
        <Border Grid.Column="0"
                Background="#151A20"
                BorderBrush="#26313D"
                BorderThickness="0,0,1,0"
                Padding="18">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="NordControl"
                               Foreground="#F4F7FA"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Personal Windows control center"
                               Foreground="#8FA1B3"
                               FontSize="12"/>
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="0,28,0,0"
                         ItemsSource="{Binding Modules}"
                         SelectedItem="{Binding SelectedModule}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="shell:ShellModuleViewModel">
                            <Border Padding="12,10"
                                    CornerRadius="8"
                                    Background="#1D252E">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="#F4F7FA"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="#8FA1B3"
                                               FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        Background="#1D252E"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Platform"
                                   Foreground="#8FA1B3"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PlatformSummary}"
                                   Foreground="#D8E1EA"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1">
            <StackPanel Margin="34,30,34,34" Spacing="22">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding ActiveModuleName}"
                                   Foreground="#F4F7FA"
                                   FontSize="30"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ActiveModuleDescription}"
                                   Foreground="#9AAABD"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   MaxWidth="760"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            VerticalAlignment="Top"
                            Background="#223040"
                            BorderBrush="#34506A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,7">
                        <TextBlock Text="{Binding ActiveModuleStatus}"
                                   Foreground="#B7D7F2"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <ContentControl Content="{Binding CurrentPageViewModel}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
