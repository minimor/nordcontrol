<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NordControl.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="760"
        x:Class="NordControl.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="NordControl"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="600"
        Background="#101418">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#D8E1EA"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="#D8E1EA"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="260,*">
        <Border Grid.Column="0"
                Background="#151A20"
                BorderBrush="#26313D"
                BorderThickness="0,0,1,0"
                Padding="18">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="NordControl"
                               Foreground="#F4F7FA"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Personal Windows control center"
                               Foreground="#8FA1B3"
                               FontSize="12"/>
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="0,28,0,0"
                         ItemsSource="{Binding Modules}"
                         SelectedItem="{Binding SelectedModule}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShellModuleViewModel">
                            <Border Padding="12,10"
                                    CornerRadius="8"
                                    Background="#1D252E">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="#F4F7FA"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="#8FA1B3"
                                               FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        Background="#1D252E"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Platform"
                                   Foreground="#8FA1B3"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PlatformSummary}"
                                   Foreground="#D8E1EA"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1">
            <StackPanel Margin="34,30,34,34" Spacing="22">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding ActiveModuleName}"
                                   Foreground="#F4F7FA"
                                   FontSize="30"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ActiveModuleDescription}"
                                   Foreground="#9AAABD"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   MaxWidth="760"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            VerticalAlignment="Top"
                            Background="#223040"
                            BorderBrush="#34506A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,7">
                        <TextBlock Text="{Binding ActiveModuleStatus}"
                                   Foreground="#B7D7F2"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel IsVisible="{Binding IsDashboardSelected}" Spacing="18">
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="16">
                        <Border Background="#161D24"
                                BorderBrush="#273442"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Open Windows"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding OpenWindowCount}"
                                           Foreground="#F4F7FA"
                                           FontSize="30"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#161D24"
                                BorderBrush="#273442"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Topmost Windows"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TopMostWindowCount}"
                                           Foreground="#F4F7FA"
                                           FontSize="30"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#161D24"
                                BorderBrush="#273442"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Current Profile"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentProfile}"
                                           Foreground="#F4F7FA"
                                           FontSize="30"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="#161D24"
                            BorderBrush="#273442"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Window Snapshot"
                                       Foreground="#F4F7FA"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding WindowOperationMessage}"
                                       Foreground="#9AAABD"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LastRefreshText}"
                                       Foreground="#B7D7F2"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsWindowManagerSelected}" Spacing="18">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">
                        <Button Content="Refresh"
                                Command="{Binding RefreshWindowsCommand}"/>
                        <TextBox Grid.Column="1"
                                 PlaceholderText="Search by window title or process"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 MinHeight="36"/>
                        <Button Grid.Column="2"
                                Content="Clear"
                                Command="{Binding ClearSearchCommand}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="16">
                        <Border Background="#161D24"
                                BorderBrush="#273442"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Open Windows"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding OpenWindowCount}"
                                           Foreground="#F4F7FA"
                                           FontSize="26"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#161D24"
                                BorderBrush="#273442"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Topmost"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TopMostWindowCount}"
                                           Foreground="#F4F7FA"
                                           FontSize="26"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#161D24"
                                BorderBrush="#273442"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Last Refresh"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LastRefreshText}"
                                           Foreground="#F4F7FA"
                                           FontSize="26"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="#161D24"
                            BorderBrush="#273442"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{Binding WindowOperationMessage}"
                                       Foreground="#B7D7F2"
                                       TextWrapping="Wrap"/>

                            <Grid ColumnDefinitions="2.5*,1.1*,80,110,90,130"
                                  ColumnSpacing="12"
                                  IsVisible="{Binding HasFilteredWindows}">
                                <TextBlock Text="Window title"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="Process"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2"
                                           Text="PID"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3"
                                           Text="HWND"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="4"
                                           Text="Status"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="5"
                                           Text="Actions"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding FilteredWindows}"
                                          IsVisible="{Binding HasFilteredWindows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WindowRowViewModel">
                                        <Border Background="#11171D"
                                                BorderBrush="#253240"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="2.5*,1.1*,80,110,90,130"
                                                  ColumnSpacing="12"
                                                  VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="#F4F7FA"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Title}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProcessName}"
                                                           Foreground="#D8E1EA"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ProcessId}"
                                                           Foreground="#9AAABD"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding HandleHex}"
                                                           Foreground="#9AAABD"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Status}"
                                                           Foreground="#B7D7F2"
                                                           FontWeight="SemiBold"/>
                                                <StackPanel Grid.Column="5"
                                                            Orientation="Horizontal"
                                                            Spacing="8">
                                                    <Button Content="Pin"
                                                            Command="{Binding PinCommand}"
                                                            IsVisible="{Binding CanPin}"/>
                                                    <Button Content="Unpin"
                                                            Command="{Binding UnpinCommand}"
                                                            IsVisible="{Binding CanUnpin}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="#11171D"
                                    BorderBrush="#253240"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18"
                                    IsVisible="{Binding ShowNoWindowsEmptyState}">
                                <TextBlock Text="No windows found. Try refreshing the list."
                                           Foreground="#9AAABD"/>
                            </Border>

                            <Border Background="#11171D"
                                    BorderBrush="#253240"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18"
                                    IsVisible="{Binding ShowNoSearchResultsEmptyState}">
                                <TextBlock Text="No windows match your search."
                                           Foreground="#9AAABD"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsCustomizationSelected}" Spacing="18">
                    <Border Background="#18202A"
                            BorderBrush="#3B5268"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <Grid ColumnDefinitions="*,220"
                              ColumnSpacing="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Customization Studio"
                                           Foreground="#F4F7FA"
                                           FontSize="24"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Make Windows feel more personal, modern and enjoyable."
                                           Foreground="#AFC2D3"
                                           FontSize="14"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding PersonalizationStatusMessage}"
                                           Foreground="#8CF5D2"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#111821"
                                    BorderBrush="#435A73"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="NordControl Accent"
                                               Foreground="#8FA1B3"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <Border Background="{Binding NordControlAccentColorHex}"
                                            Height="42"
                                            CornerRadius="8"/>
                                    <TextBlock Text="{Binding NordControlAccentColorHex}"
                                               Foreground="#F4F7FA"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Background="#111821"
                            BorderBrush="#2B3B4B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <ItemsControl ItemsSource="{Binding CustomizationSections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomizationSectionViewModel">
                                    <Button Command="{Binding SelectCommand}"
                                            Margin="0,0,8,8"
                                            Padding="12,8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#F4F7FA"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Badge}"
                                                       Foreground="#8CF5D2"
                                                       FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Background="#151D27"
                            BorderBrush="#304459"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding CurrentCustomizationSectionName}"
                                           Foreground="#F4F7FA"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentCustomizationSectionDescription}"
                                           Foreground="#AFC2D3"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#223040"
                                    BorderBrush="#435A73"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,7"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding CurrentCustomizationSectionBadge}"
                                           Foreground="#B7D7F2"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="14"
                          RowSpacing="14"
                          IsVisible="{Binding IsCustomizationOverviewSection}">
                        <Border Background="#161D24"
                                BorderBrush="#2C3C4E"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Apps Theme"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AppsTheme}"
                                           Foreground="#F4F7FA"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1"
                                Background="#161D24"
                                BorderBrush="#2C3C4E"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="System Theme"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SystemTheme}"
                                           Foreground="#F4F7FA"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2"
                                Background="#161D24"
                                BorderBrush="#2C3C4E"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Transparency"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TransparencyEffectsEnabled}"
                                           Foreground="#F4F7FA"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1"
                                Background="#161D24"
                                BorderBrush="#2C3C4E"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Accent Color"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{Binding WindowsAccentColorHex}"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="8"/>
                                    <TextBlock Text="{Binding WindowsAccentColorHex}"
                                               Foreground="#F4F7FA"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Background="#161D24"
                                BorderBrush="#2C3C4E"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Accent on Title Bars"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AccentColorOnTitleBars}"
                                           Foreground="#F4F7FA"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Background="#161D24"
                                BorderBrush="#2C3C4E"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Last Loaded"
                                           Foreground="#8FA1B3"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PersonalizationLastLoadedText}"
                                           Foreground="#F4F7FA"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="#161D24"
                            BorderBrush="#2C3C4E"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            IsVisible="{Binding IsCustomizationOverviewSection}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Wallpaper"
                                       Foreground="#8FA1B3"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding WallpaperPath}"
                                       Foreground="#D8E1EA"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                          ColumnSpacing="10"
                          IsVisible="{Binding IsCustomizationThemesSection}">
                        <Button Content="Refresh current style"
                                Command="{Binding RefreshPersonalizationCommand}"/>
                        <Button Grid.Column="1"
                                Content="Toggle apps theme"
                                Command="{Binding ToggleAppsThemeCommand}"/>
                        <Button Grid.Column="2"
                                Content="Toggle system theme"
                                Command="{Binding ToggleSystemThemeCommand}"/>
                        <Button Grid.Column="3"
                                Content="Toggle transparency"
                                Command="{Binding ToggleTransparencyEffectsCommand}"/>
                        <Button Grid.Column="4"
                                Content="Toggle title-bar accent"
                                Command="{Binding ToggleAccentColorOnTitleBarsCommand}"/>
                    </Grid>

                    <StackPanel Spacing="12"
                                IsVisible="{Binding IsCustomizationThemesSection}">
                        <TextBlock Text="Preset Gallery"
                                   Foreground="#F4F7FA"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding CustomizationPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomizationPresetViewModel">
                                    <Border Width="250"
                                            MinHeight="210"
                                            Margin="0,0,14,14"
                                            Background="#151D27"
                                            BorderBrush="#304459"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,42">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#F4F7FA"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"/>
                                                <Border Grid.Column="1"
                                                        Background="{Binding AccentColorHex}"
                                                        Width="34"
                                                        Height="34"
                                                        CornerRadius="8"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="#AFC2D3"
                                                       TextWrapping="Wrap"
                                                       MinHeight="52"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding StyleMood}"
                                                           Foreground="#8CF5D2"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding RiskLevel}"
                                                           Foreground="#FFD166"/>
                                            </Grid>
                                            <TextBlock Text="{Binding BackgroundHint}"
                                                       Foreground="#8FA1B3"/>
                                            <Button Content="Preview / Apply to NordControl"
                                                    Command="{Binding ApplyCommand}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="12"
                                IsVisible="{Binding IsCustomizationOverviewSection}">
                        <TextBlock Text="Desktop Environment Roadmap"
                                   Foreground="#F4F7FA"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding CurrentCustomizationFeatureCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomizationFeatureCardViewModel">
                                    <Border Width="250"
                                            MinHeight="168"
                                            Margin="0,0,14,14"
                                            Background="#151D27"
                                            BorderBrush="#304459"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16">
                                        <StackPanel Spacing="9">
                                            <Grid ColumnDefinitions="*,34">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#F4F7FA"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <Border Grid.Column="1"
                                                        Background="{Binding AccentColorHex}"
                                                        Width="28"
                                                        Height="28"
                                                        CornerRadius="8"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="#AFC2D3"
                                                       TextWrapping="Wrap"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Badge}"
                                                           Foreground="#8CF5D2"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding RiskLevel}"
                                                           Foreground="#FFD166"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="12"
                                IsVisible="{Binding IsCustomizationPlanningSection}">
                        <Border Background="#1F1A2C"
                                BorderBrush="#57427A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18"
                                IsVisible="{Binding IsCustomizationRiskLabSection}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Risk Lab"
                                           Foreground="#F4F7FA"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="These experiments are disabled for now. Shell-level customization can break after Windows updates and will require explicit confirmation, logging, and rollback planning."
                                           Foreground="#FFD6D6"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding CurrentCustomizationFeatureCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomizationFeatureCardViewModel">
                                    <Border Width="270"
                                            MinHeight="198"
                                            Margin="0,0,14,14"
                                            Background="#151D27"
                                            BorderBrush="#304459"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,38">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#F4F7FA"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <Border Grid.Column="1"
                                                        Background="{Binding AccentColorHex}"
                                                        Width="32"
                                                        Height="32"
                                                        CornerRadius="8"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="#AFC2D3"
                                                       TextWrapping="Wrap"
                                                       MinHeight="56"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Badge}"
                                                           Foreground="#8CF5D2"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding RiskLevel}"
                                                           Foreground="#FFD166"/>
                                            </Grid>
                                            <Button Content="Coming later"
                                                    IsEnabled="False"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="16"
                          IsVisible="{Binding IsCustomizationOverviewSection}">
                        <Border Background="#16251F"
                                BorderBrush="#2D705D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Safety Notes"
                                           Foreground="#F4F7FA"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Safe changes only. No Explorer patching, no system DLL modifications, no process injection, and no risky optimizer behavior."
                                           Foreground="#BEEBDD"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Riskier features will require explicit confirmation, logs, and rollback planning in future versions."
                                           Foreground="#8FA1B3"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#1F1A2C"
                                BorderBrush="#57427A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Future Features"
                                           Foreground="#F4F7FA"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Transparent taskbar, Start menu experiments, desktop widgets, window border styles, per-app visual profiles, and a custom command palette."
                                           Foreground="#D9C8FF"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="These are planned, not implemented."
                                           Foreground="#8FA1B3"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSettingsSelected}" Spacing="18">
                    <Border Background="#161D24"
                            BorderBrush="#273442"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Settings File"
                                       Foreground="#F4F7FA"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SettingsFilePath}"
                                       Foreground="#B7D7F2"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SettingsStatusMessage}"
                                       Foreground="#9AAABD"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#161D24"
                            BorderBrush="#273442"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Theme"
                                       Foreground="#F4F7FA"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <RadioButton Content="Dark"
                                             IsChecked="True"/>
                                <RadioButton Content="Light (coming later)"
                                             IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#161D24"
                            BorderBrush="#273442"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Window Manager"
                                       Foreground="#F4F7FA"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>

                            <CheckBox Content="Refresh window list on startup"
                                      IsChecked="{Binding RefreshOnStartup, Mode=TwoWay}"/>

                            <Grid ColumnDefinitions="260,160,*"
                                  ColumnSpacing="12"
                                  VerticalAlignment="Center">
                                <TextBlock Text="Auto refresh interval seconds"
                                           Foreground="#D8E1EA"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding AutoRefreshIntervalSeconds, Mode=TwoWay}"
                                         MinHeight="34"/>
                                <TextBlock Grid.Column="2"
                                           Text="0 disables auto-refresh. A positive value refreshes the window list every N seconds."
                                           Foreground="#8FA1B3"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="{Binding AutoRefreshStatus}"
                                       Foreground="#B7D7F2"
                                       TextWrapping="Wrap"/>

                            <CheckBox Content="Confirm before pinning"
                                      IsChecked="{Binding ConfirmBeforePinning, Mode=TwoWay}"/>

                            <CheckBox Content="Show unknown processes"
                                      IsChecked="{Binding ShowUnknownProcesses, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#161D24"
                            BorderBrush="#273442"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Customization"
                                       Foreground="#F4F7FA"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="220,*"
                                  ColumnSpacing="12">
                                <TextBlock Text="Selected preset"
                                           Foreground="#D8E1EA"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedCustomizationPresetKey}"
                                           Foreground="#B7D7F2"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="220,*"
                                  ColumnSpacing="12">
                                <TextBlock Text="Customization section"
                                           Foreground="#D8E1EA"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentCustomizationSectionName}"
                                           Foreground="#B7D7F2"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="220,*"
                                  ColumnSpacing="12">
                                <TextBlock Text="NordControl accent"
                                           Foreground="#D8E1EA"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding NordControlAccentColorHex, Mode=TwoWay}"
                                         MinHeight="34"/>
                            </Grid>
                            <CheckBox Content="Enable glass style in NordControl preview"
                                      IsChecked="{Binding EnableGlassStyleInApp, Mode=TwoWay}"/>
                            <CheckBox Content="Allow low-risk Windows personalization actions"
                                      IsChecked="{Binding AllowLowRiskWindowsPersonalization, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                          ColumnSpacing="12">
                        <Button Content="Save Settings"
                                Command="{Binding SaveSettingsCommand}"/>
                        <Button Grid.Column="1"
                                Content="Reload Settings"
                                Command="{Binding ReloadSettingsCommand}"/>
                        <Button Grid.Column="2"
                                Content="Reset to Defaults"
                                Command="{Binding ResetSettingsCommand}"/>
                    </Grid>
                </StackPanel>

                <Border IsVisible="{Binding IsPlaceholderModuleSelected}"
                        Background="#161D24"
                        BorderBrush="#273442"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Module Workspace"
                                   Foreground="#F4F7FA"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="This module is prepared in the shell and will be implemented in a later stage."
                                   Foreground="#9AAABD"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
