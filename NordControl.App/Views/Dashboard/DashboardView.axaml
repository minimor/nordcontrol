<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NordControl.App.ViewModels.Dashboard"
             x:Class="NordControl.App.Views.Dashboard.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <StackPanel Spacing="18">
        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="16">
            <Border Background="#161D24"
                    BorderBrush="#273442"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Open Windows"
                               Foreground="#8FA1B3"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding OpenWindowCount}"
                               Foreground="#F4F7FA"
                               FontSize="30"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#161D24"
                    BorderBrush="#273442"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Topmost Windows"
                               Foreground="#8FA1B3"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TopMostWindowCount}"
                               Foreground="#F4F7FA"
                               FontSize="30"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#161D24"
                    BorderBrush="#273442"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Current Profile"
                               Foreground="#8FA1B3"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentProfile}"
                               Foreground="#F4F7FA"
                               FontSize="30"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Background="#161D24"
                BorderBrush="#273442"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <StackPanel Spacing="10">
                <TextBlock Text="Window Snapshot"
                           Foreground="#F4F7FA"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding WindowOperationMessage}"
                           Foreground="#9AAABD"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LastRefreshText}"
                           Foreground="#B7D7F2"
                           FontSize="12"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
